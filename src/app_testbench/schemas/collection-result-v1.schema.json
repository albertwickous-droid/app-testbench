{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:app-testbench:collection-result:1.0",
  "title": "app-testbench suite or data-driven result",
  "description": "Stable aggregate result for suite and data-driven runs.",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "name",
    "description",
    "status",
    "started_at",
    "finished_at",
    "duration_ms",
    "tags",
    "summary",
    "cases",
    "output_dir",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "app-testbench-suite-result",
        "app-testbench-data-result"
      ]
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "passed",
        "failed",
        "skipped"
      ]
    },
    "started_at": {
      "type": "string"
    },
    "finished_at": {
      "type": "string"
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "cases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/case"
      }
    },
    "output_dir": {
      "type": "string"
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "summary": {
      "type": "object",
      "required": [
        "total",
        "passed",
        "failed",
        "skipped",
        "duration_ms"
      ],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "case": {
      "type": "object",
      "required": [
        "index",
        "label",
        "flow",
        "flow_path",
        "tags",
        "variable_names",
        "data_index",
        "status",
        "started_at",
        "finished_at",
        "duration_ms",
        "summary",
        "warnings",
        "error",
        "run_dir",
        "report_path",
        "result_path",
        "manifest_path"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 1
        },
        "label": {
          "type": "string"
        },
        "flow": {
          "type": "string"
        },
        "flow_path": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "variable_names": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "data_index": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "passed",
            "failed",
            "skipped"
          ]
        },
        "started_at": {
          "type": "string"
        },
        "finished_at": {
          "type": "string"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "summary": {
          "type": "object",
          "required": [
            "passed",
            "failed",
            "skipped",
            "total"
          ],
          "properties": {
            "passed": {
              "type": "integer",
              "minimum": 0
            },
            "failed": {
              "type": "integer",
              "minimum": 0
            },
            "skipped": {
              "type": "integer",
              "minimum": 0
            },
            "total": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": true
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "run_dir": {
          "type": "string"
        },
        "report_path": {
          "type": "string"
        },
        "result_path": {
          "type": "string"
        },
        "manifest_path": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  }
}
