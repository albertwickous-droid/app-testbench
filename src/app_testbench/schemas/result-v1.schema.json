{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:app-testbench:result:1.0",
  "title": "app-testbench run result",
  "description": "Stable machine-readable result written to result.json.",
  "type": "object",
  "required": [
    "schema_version",
    "name",
    "status",
    "started_at",
    "finished_at",
    "duration_ms",
    "summary",
    "environment",
    "config",
    "steps",
    "logcat_paths",
    "warnings",
    "output_dir",
    "report_path",
    "result_path"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+$"
    },
    "name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "passed",
        "failed",
        "skipped"
      ]
    },
    "started_at": {
      "type": "string"
    },
    "finished_at": {
      "type": "string"
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "environment": {
      "type": "object"
    },
    "config": {
      "type": "object"
    },
    "steps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "logcat_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "output_dir": {
      "type": "string"
    },
    "report_path": {
      "type": "string"
    },
    "result_path": {
      "type": "string"
    },
    "junit_path": {
      "type": "string"
    }
  },
  "additionalProperties": true,
  "$defs": {
    "summary": {
      "type": "object",
      "required": [
        "passed",
        "failed",
        "skipped",
        "total"
      ],
      "properties": {
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "step": {
      "type": "object",
      "required": [
        "id",
        "name",
        "action",
        "section",
        "status",
        "started_at",
        "duration_ms",
        "description",
        "params",
        "output",
        "error",
        "hint",
        "screenshots",
        "ui_files"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "action": {
          "type": "string"
        },
        "section": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "passed",
            "failed",
            "skipped"
          ]
        },
        "started_at": {
          "type": "string"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "params": {
          "type": "object"
        },
        "output": {
          "type": "object"
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "hint": {
          "type": [
            "string",
            "null"
          ]
        },
        "screenshots": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ui_files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    }
  }
}
